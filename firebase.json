{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "public",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "config.local.js",
      "server.js",
      "app.py",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      },
      {
        "source": "**/*.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.mjs",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.css",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "**",
        "headers": [
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://www.gstatic.com https://www.google.com https://www.google.com/recaptcha/ https://cdn.jsdelivr.net https://unpkg.com https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://unpkg.com https://fonts.googleapis.com; font-src 'self' data: https://cdn.jsdelivr.net https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' blob: http://127.0.0.1:8787 http://localhost:8787 https://cdn.jsdelivr.net https://www.gstatic.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://firestore.googleapis.com https://firebase.googleapis.com https://firebasestorage.googleapis.com https://storage.googleapis.com https://content-firebaseappcheck.googleapis.com https://firebaseappcheck.googleapis.com https://charly-brown-gemini-backend.onrender.com https://gemini-veo.onrender.com https://*.onrender.com; frame-src 'self' https://www.google.com https://recaptcha.google.com; media-src 'self' blob: data: https:; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'"
          },
          {
            "key": "Cache-Control",
            "value": "no-store"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(self), microphone=(self), geolocation=()"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=31536000; includeSubDomains; preload"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/api/podcaster/montage/export",
        "destination": "https://snoopy-export.onrender.com/api/podcaster/montage/export",
        "type": 307
      },
      {
        "source": "/api/podcaster/montage/export-v2",
        "destination": "https://snoopy-export.onrender.com/api/podcaster/montage/export-v2",
        "type": 307
      },
      {
        "source": "/api/podcaster/montage/export-status",
        "destination": "https://snoopy-export.onrender.com/api/podcaster/montage/export-status",
        "type": 302
      },
      {
        "source": "/api/podcaster/montage/export-cancel",
        "destination": "https://snoopy-export.onrender.com/api/podcaster/montage/export-cancel",
        "type": 307
      },
      {
        "source": "/api/podcaster/sessions/:path*",
        "destination": "https://snoopy-export.onrender.com/api/podcaster/sessions/:path*",
        "type": 307
      },
      {
        "source": "/api/podcaster/scene-library/:path*",
        "destination": "https://snoopy-export.onrender.com/api/podcaster/scene-library/:path*",
        "type": 307
      },
      {
        "source": "/api/podcaster/music/upload",
        "destination": "https://snoopy-export.onrender.com/api/podcaster/music/upload",
        "type": 307
      },
      {
        "source": "/api/podcaster/music/library/:path*",
        "destination": "https://snoopy-export.onrender.com/api/podcaster/music/library/:path*",
        "type": 307
      },
      {
        "source": "/api/podcaster/scene-media/upload",
        "destination": "https://snoopy-export.onrender.com/api/podcaster/scene-media/upload",
        "type": 307
      },
      {
        "source": "/api/assets/proxy-media",
        "destination": "https://snoopy-export.onrender.com/api/assets/proxy-media",
        "type": 302
      },
      {
        "source": "/api/assets/proxy-image",
        "destination": "https://snoopy-export.onrender.com/api/assets/proxy-image",
        "type": 302
      },
      {
        "source": "/api/assets/montage-download",
        "destination": "https://snoopy-export.onrender.com/api/assets/montage-download",
        "type": 302
      },
      {
        "source": "/api/podcaster/speaker-portraits/generate",
        "destination": "https://gemini-veo.onrender.com/api/podcaster/speaker-portraits/generate",
        "type": 302
      },
      {
        "source": "/api/podcaster/scenario-images/generate",
        "destination": "https://gemini-veo.onrender.com/api/podcaster/scenario-images/generate",
        "type": 302
      },
      {
        "source": "/api/podcaster/dialogue-videos/generate",
        "destination": "https://gemini-veo.onrender.com/api/podcaster/dialogue-videos/generate",
        "type": 302
      },
      {
        "source": "/api/podcaster/dialogue-videos/generate-status",
        "destination": "https://gemini-veo.onrender.com/api/podcaster/dialogue-videos/generate-status",
        "type": 302
      },
      {
        "source": "/api/podcaster/dialogue-videos/generate-sync",
        "destination": "https://gemini-veo.onrender.com/api/podcaster/dialogue-videos/generate-sync",
        "type": 302
      },
      {
        "source": "/api/:path*",
        "destination": "https://charly-brown-gemini-backend.onrender.com/api/:path*",
        "type": 302
      }
    ],
    "rewrites": [
      {
        "source": "/",
        "destination": "/index.html"
      }
    ]
  }
}
