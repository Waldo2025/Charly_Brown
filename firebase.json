{
  "functions": [
    {
      "source": "functions",
      "codebase": "charly-google",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "node scripts/build-charly-exercise-catalog.mjs --check",
        "node scripts/build-science-production-policy.mjs"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "public",
    "cleanUrls": true,
    "rewrites": [
      {
        "source": "/api/science-activities/**",
        "function": {
          "functionId": "scienceActivitiesApi",
          "region": "us-central1"
        }
      }
    ],
    "ignore": [
      "firebase.json",
      "config.local.js",
      "server.js",
      "app.py",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      },
      {
        "source": "**/*.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
          }
        ]
      },
      {
        "source": "**/*.mjs",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
          }
        ]
      },
      {
        "source": "**/*.css",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
          }
        ]
      },
      {
        "source": "/MarcieBlogEditor/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
          }
        ]
      },
      {
        "source": "/PigPenCreator*",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
          }
        ]
      },
      {
        "source": "/js/PigPenCreator.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
          }
        ]
      },
      {
        "source": "/js/pigpen-*",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
          }
        ]
      },
      {
        "source": "/js/escape-room-*",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
          }
        ]
      },
      {
        "source": "/js/{api-client,firebase-default-app,firebase-app-check,html-docx}.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
          }
        ]
      },
      {
        "source": "/version.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      },
      {
        "source": "/js/{cache-version-loader,runtime-config-loader,update-banner-loader}.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
          }
        ]
      },
      {
        "source": "/{scienceActivities.css,js/scienceActivities.js,js/scienceActivities.bundle.js,tailwind-lite.css}",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
          }
        ]
      },
      {
        "source": "/{podcaster*,js/chromeLayout.js,js/sidebar.js,sidebar.css,header.css,local-fonts.css,js/api-client-podcaster.js,js/firebase-web-config.js}",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
          }
        ]
      },
      {
        "source": "/podcaster/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
          }
        ]
      },
      {
        "source": "/js/science-*.mjs",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
          }
        ]
      },
      {
        "source": "/js/science-chunks/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
          }
        ]
      },
      {
        "source": "**/*.{woff,woff2,ttf,otf}",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**",
        "headers": [
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://www.gstatic.com https://www.google.com https://www.google.com/recaptcha/ https://cdn.jsdelivr.net https://unpkg.com https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://unpkg.com https://fonts.googleapis.com; font-src 'self' data: https://cdn.jsdelivr.net https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://sally-browser-mm2qel4fka-uc.a.run.app wss://sally-browser-mm2qel4fka-uc.a.run.app blob: http://127.0.0.1:8787 http://localhost:8787 https://cdn.jsdelivr.net https://www.gstatic.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://firestore.googleapis.com https://firebase.googleapis.com https://firebasestorage.googleapis.com https://storage.googleapis.com https://content-firebaseappcheck.googleapis.com https://firebaseappcheck.googleapis.com https://us-central1-charly-brown.cloudfunctions.net; frame-src 'self' https://www.google.com https://recaptcha.google.com; media-src 'self' blob: data: https:; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'"
          },
          {
            "key": "Content-Security-Policy-Report-Only",
            "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://www.gstatic.com https://www.google.com https://www.google.com/recaptcha/ https://cdn.jsdelivr.net https://unpkg.com https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://unpkg.com https://fonts.googleapis.com; font-src 'self' data: https://cdn.jsdelivr.net https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' blob: https://www.gstatic.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://firestore.googleapis.com https://firebase.googleapis.com https://firebasestorage.googleapis.com https://storage.googleapis.com https://content-firebaseappcheck.googleapis.com https://firebaseappcheck.googleapis.com https://us-central1-charly-brown.cloudfunctions.net; frame-src 'self' https://www.google.com https://recaptcha.google.com; media-src 'self' blob: data: https:; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(self), microphone=(self), geolocation=()"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=31536000; includeSubDomains; preload"
          }
        ]
      },
      {
        "source": "/science-mcp-consent.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          },
          {
            "key": "Referrer-Policy",
            "value": "no-referrer"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/api/pigpen/generation",
        "function": {
          "functionId": "pigpenGenerationApi",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/pigpen/generation/**",
        "function": {
          "functionId": "pigpenGenerationApi",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/pigpen/mcp",
        "function": {
          "functionId": "pigpenGenerationApi",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/pigpen/**",
        "function": {
          "functionId": "assetApi",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/analizar-pdf/**",
        "function": {
          "functionId": "analizarPdfApi",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/assets/**",
        "function": {
          "functionId": "assetApi",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/podcaster/speaker-portraits/**",
        "function": {
          "functionId": "veoApi",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/podcaster/scenario-images/**",
        "function": {
          "functionId": "veoApi",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/podcaster/dialogue-videos/**",
        "function": {
          "functionId": "veoApi",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/podcaster/dialogue-audio/**",
        "function": {
          "functionId": "geminiApi",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/podcaster/dialogue-audios/**",
        "function": {
          "functionId": "geminiApi",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/podcaster/tts/voices",
        "function": {
          "functionId": "geminiApi",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/podcaster/tts/preview",
        "function": {
          "functionId": "geminiApi",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/podcaster/music/generate",
        "function": {
          "functionId": "geminiApi",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/schroeder/**",
        "function": {
          "functionId": "geminiApi",
          "region": "us-central1"
        }
      },
      {
        "source": "/.well-known/oauth-authorization-server",
        "function": {
          "functionId": "scienceActivitiesApi",
          "region": "us-central1"
        }
      },
      {
        "source": "/.well-known/oauth-protected-resource/api/science-activities/mcp",
        "function": {
          "functionId": "scienceActivitiesApi",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/science-activities/**",
        "function": {
          "functionId": "scienceActivitiesApi",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/gemini/**",
        "function": {
          "functionId": "geminiApi",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/podcaster/**",
        "function": {
          "functionId": "podcasterApi",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/**",
        "function": {
          "functionId": "geminiApi",
          "region": "us-central1"
        }
      },
      {
        "source": "/",
        "destination": "/index.html"
      }
    ]
  }
}
