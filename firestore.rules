rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function roleFromToken() {
      return isSignedIn() && request.auth.token.role != null
        ? request.auth.token.role
        : "";
    }

    function roleFromUserDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role != null
            ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
            : (
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.rol != null
                ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.rol
                : (
                  get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userRole != null
                    ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userRole
                    : ""
                )
            )
        )
        : "";
    }

    function isAudioSessionOwner(sessionId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/audioTranslate/$(sessionId)) &&
        get(/databases/$(database)/documents/audioTranslate/$(sessionId)).data.userId == request.auth.uid;
    }

    function hasRole(role) {
      return isSignedIn() && (
        roleFromToken() == role ||
        roleFromUserDoc() == role
      );
    }

    function hasAnyRole(roles) {
      return isSignedIn() && (
        roles.hasAny([roleFromToken()]) ||
        roles.hasAny([roleFromUserDoc()])
      );
    }

    function isAdmin() {
      return hasAnyRole([
        "admin", "Admin", "administrador", "Administrador", "administrator", "Administrator",
        "superAdmin", "superadmin", "SuperAdmin", "owner", "Owner"
      ]);
    }

    function isEditor() {
      return isAdmin() ||
        hasAnyRole([
          "author", "Author", "autor", "Autor", "autores", "autoria", "Autoria",
          "editor", "Editor", "editorial", "Editorial", "Editoria", "editoria",
          "developer", "Developer", "desarrollo", "Desarrollo", "dev", "Dev",
          "profe", "Profe", "profesor", "Profesor", "docente", "Docente"
        ]);
    }

    function isApprovedUser() {
      return isSignedIn() && (
        isEditor() ||
        request.auth.token.approvalStatus == "approved" ||
        request.auth.token.approvalStatus == "aprobado" ||
        request.auth.token.status == "approved" ||
        request.auth.token.status == "aprobado" ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.approvalStatus == "approved" ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.approvalStatus == "aprobado" ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == "approved" ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == "aprobado" ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.estadoAprobacion == "approved" ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.estadoAprobacion == "aprobado" ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.approved == true ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.aprobado == true ||
            (
              roleFromUserDoc() != "" &&
              roleFromUserDoc() != "pending" &&
              roleFromUserDoc() != "pendiente"
            )
          )
        )
      );
    }

    function isGameDeveloper() {
      return isAdmin() || hasAnyRole([
        "developer", "Developer", "desarrollo", "Desarrollo", "dev", "Dev"
      ]);
    }

    function isOwner(uid) {
      return isSignedIn() && uid == request.auth.uid;
    }

    function isDocOwner(data) {
      return isSignedIn() && (
        data.userId == request.auth.uid ||
        data.ownerId == request.auth.uid ||
        data.uid == request.auth.uid ||
        data.ownerUid == request.auth.uid ||
        data.createdBy == request.auth.uid
      );
    }

    function isMarcieBlogEditorSessionOwner(sessionId) {
      return (
        exists(/databases/$(database)/documents/MarcieBlogEditor/$(sessionId)) &&
        isDocOwner(get(/databases/$(database)/documents/MarcieBlogEditor/$(sessionId)).data)
      );
    }

    function isConversationParticipant(conversationId) {
      return isSignedIn() && conversationId.matches("^" + request.auth.uid + "_.+$|^.+_" + request.auth.uid + "$");
    }

    function isMinebloxTeacher(roomId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/mineblox_rooms/$(roomId)) &&
        get(/databases/$(database)/documents/mineblox_rooms/$(roomId)).data.teacherId == request.auth.uid;
    }

    function isMinebloxParticipant(roomId) {
      return isSignedIn() && (
        isMinebloxTeacher(roomId) ||
        exists(/databases/$(database)/documents/mineblox_rooms/$(roomId)/players/$(request.auth.uid))
      );
    }

    function isStringField(data, key, minLen, maxLen) {
      return !(key in data) || (
        data[key] is string &&
        data[key].size() >= minLen &&
        data[key].size() <= maxLen
      );
    }

    function isOptionalBool(data, key) {
      return !(key in data) || data[key] is bool;
    }

    function isOptionalNumber(data, key) {
      return !(key in data) || data[key] is number;
    }

    function isCommentShape(data) {
      return data.uid == request.auth.uid &&
        isStringField(data, "lecturaId", 1, 200) &&
        isStringField(data, "seccion", 1, 5000) &&
        isStringField(data, "comentario", 1, 3000) &&
        isStringField(data, "autor", 1, 200) &&
        isOptionalNumber(data, "posicion") &&
        isOptionalNumber(data, "longitud") &&
        (!("seleccionadoPor" in data) || data.seleccionadoPor is list);
    }

    function isImageShareShape(data) {
      return data.uid == request.auth.uid &&
        isStringField(data, "nombre", 1, 240) &&
        isStringField(data, "url", 1, 4000) &&
        isOptionalBool(data, "share") &&
        isOptionalBool(data, "archivado") &&
        isStringField(data, "nivel", 0, 120) &&
        isStringField(data, "grado", 0, 120) &&
        isStringField(data, "trimestre", 0, 120) &&
        isStringField(data, "unidad", 0, 120);
    }

    function isChatParticipant(data) {
      return isSignedIn() && (
        data.senderId == request.auth.uid ||
        data.receiverId == request.auth.uid
      );
    }

    function isChatMessageShape(data) {
      return data.senderId == request.auth.uid &&
        isStringField(data, "receiverId", 1, 200) &&
        isStringField(data, "message", 0, 5000) &&
        isStringField(data, "imageURL", 0, 4000) &&
        isStringField(data, "audioData", 0, 15000000) &&
        isOptionalBool(data, "favorite");
    }

    function isPublished(data) {
      return data.publicar == true || data.published == true || data.estatusLectura == "Compartido";
    }

    function isLecturaSharedWithUser(data) {
      return isSignedIn() && (
        (data.sharewith is list && data.sharewith.hasAny([request.auth.uid])) ||
        (data.sharedWithIds is list && data.sharedWithIds.hasAny([request.auth.uid])) ||
        (
          request.auth.token.email is string &&
          data.sharedWith is list &&
          data.sharedWith.hasAny([request.auth.token.email])
        )
      );
    }

    function isPodcasterSharedWithUser(data) {
      return isSignedIn() &&
        data.sharedWithIds is list &&
        data.sharedWithIds.hasAny([request.auth.uid]);
    }

    function canReadPodcasterSessionData(data) {
      return isEditor() ||
        (
          isSignedIn() && (
            data.publicar == true ||
            data.published == true ||
            isOwner(data.ownerId) ||
            isPodcasterSharedWithUser(data)
          )
        );
    }

    function isAcademicMetadataDocShape(data, sessionId) {
      return data is map &&
        data.entityId == sessionId &&
        data.entityType == "session" &&
        data.academicMetadata is map &&
        data.academicMetadata.nivel is string &&
        data.academicMetadata.grado is string &&
        data.academicMetadata.trimestre is string &&
        data.academicMetadata.unidad is string &&
        data.academicMetadata.materia is string &&
        data.academicMetadata.unitLabel is string &&
        data.nivel is string &&
        data.grado is string &&
        data.trimestre is string &&
        data.unidad is string &&
        data.materia is string;
    }

    function isAcademicMetadataSessionPatch(resourceData, requestData) {
      return requestData.ownerId == resourceData.ownerId &&
        requestData.diff(resourceData).affectedKeys().hasOnly([
          "academicMetadata",
          "academicMetadataCollection",
          "academicMetadataUnitLabel",
          "academicMetadataUpdatedAt",
          "academicMetadataUpdatedAtIso",
          "academicMetadataUpdatedByUid",
          "academicMetadataUpdatedByName",
          "academicMetadataCollection",
          "nivel",
          "grado",
          "trimestre",
          "unidad",
          "materia",
          "updatedAt",
          "updatedAtIso",
          "updatedByUid",
          "updatedByName",
          "sessionUpdatedAt"
        ]);
    }

    function canAccessPodcasterSessionById(sessionId) {
      return exists(/databases/$(database)/documents/podcaster_sessions/$(sessionId)) &&
        canReadPodcasterSessionData(
          get(/databases/$(database)/documents/podcaster_sessions/$(sessionId)).data
        );
    }

    function isPodcasterSessionShape(data, sessionId) {
      return (data.ownerId is string) &&
        isStringField(data, "title", 0, 240) &&
        isOptionalBool(data, "archived") &&
        isStringField(data, "sessionUpdatedAt", 0, 80) &&
        data.session is map &&
        data.session.id is string &&
        data.session.id == sessionId &&
        (!("sharedWithIds" in data) || data.sharedWithIds is list) &&
        (!("sharedWith" in data) || data.sharedWith is list);
    }

    function isAllowedAnalizarPdfStatus(value) {
      return [
        "idle",
        "uploading",
        "queued",
        "processing",
        "completed",
        "failed"
      ].hasAny([value]);
    }

    function isAnalizarPdfSessionShape(data, sessionId) {
      return data.ownerId is string &&
        data.ownerId.size() > 0 &&
        data.id is string &&
        data.id == sessionId &&
        data.sourceType is string &&
        ["pdf", "idml"].hasAny([data.sourceType]) &&
        isStringField(data, "title", 0, 240) &&
        isStringField(data, "createdAt", 0, 80) &&
        isStringField(data, "updatedAt", 0, 80) &&
        isStringField(data, "analysisJobId", 0, 160) &&
        (
          !("analysisStatus" in data) ||
          (data.analysisStatus is string && isAllowedAnalizarPdfStatus(data.analysisStatus))
        ) &&
        (!("indexConfig" in data) || data.indexConfig is map) &&
        (!("resultSummary" in data) || data.resultSummary is map) &&
        (!("result" in data) || data.result is map);
    }

    function isImageCreatorSessionShape(data) {
      return (data.ownerId is string) &&
        data.ownerId.size() > 0 &&
        isStringField(data, "ownerEmail", 0, 240) &&
        isStringField(data, "title", 0, 240) &&
        isOptionalBool(data, "archived") &&
        isStringField(data, "lastPrompt", 0, 5000) &&
        data.session is map &&
        (
          !("messages" in data.session) ||
          (
            data.session.messages is list &&
            data.session.messages.size() <= 30
          )
        );
    }

    function isMoodleCourseOwnerData(data) {
      return isSignedIn() && (
        data.userId == request.auth.uid ||
        data.uid == request.auth.uid ||
        data.ownerUid == request.auth.uid
      );
    }

    function isMoodleCourseSharedData(data) {
      return isSignedIn() && (
        (data.compartidoCon is list && data.compartidoCon.hasAny([request.auth.uid])) ||
        (data.sharedWithIds is list && data.sharedWithIds.hasAny([request.auth.uid]))
      );
    }

    function moodleRootCourseId(data, docId) {
      return data.cursoId is string && data.cursoId.size() > 0
        ? data.cursoId
        : docId;
    }

    function canAccessMoodleCourseData(data, docId) {
      return isSignedIn() && (
        isEditor() ||
        isMoodleCourseOwnerData(data) ||
        isMoodleCourseSharedData(data) ||
        (
          data.cursoId is string &&
          exists(/databases/$(database)/documents/moodleCourses/$(moodleRootCourseId(data, docId))) &&
          (
            isMoodleCourseOwnerData(get(/databases/$(database)/documents/moodleCourses/$(moodleRootCourseId(data, docId))).data) ||
            isMoodleCourseSharedData(get(/databases/$(database)/documents/moodleCourses/$(moodleRootCourseId(data, docId))).data)
          )
        )
      );
    }

    // Lecturas compartidas y privadas de edición.
    match /lecturas/{lecturaId} {
      allow read: if isSignedIn() || isPublished(resource.data) || isEditor() || isDocOwner(resource.data);
      allow create: if isEditor() || isDocOwner(request.resource.data);
      allow update, delete: if isEditor() || isDocOwner(resource.data);
    }

    match /podcaster_sessions/{sessionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isPodcasterSessionShape(request.resource.data, sessionId);
      allow update: if isSignedIn() &&
        (
          (
            request.resource.data.ownerId == resource.data.ownerId &&
            isPodcasterSessionShape(request.resource.data, sessionId)
          ) || (
            isApprovedUser() &&
            isAcademicMetadataSessionPatch(resource.data, request.resource.data)
          )
        );
      allow delete: if isAdmin();

      match /audit_events/{eventId} {
        allow read: if isSignedIn();
      }
    }

    match /podcaster_academic_metadata/{sessionId} {
      allow read: if isSignedIn();
      allow create, update: if isApprovedUser() && isAcademicMetadataDocShape(request.resource.data, sessionId);
      allow delete: if isAdmin();
    }

    match /experiencia_menu_sessions/{sessionId} {
      allow read: if isSignedIn() && isOwner(resource.data.ownerId);
      allow create: if isSignedIn() &&
        isOwner(request.resource.data.ownerId) &&
        request.resource.data.sessionId == sessionId;
      allow update: if isSignedIn() &&
        isOwner(resource.data.ownerId) &&
        request.resource.data.ownerId == resource.data.ownerId &&
        request.resource.data.sessionId == sessionId;
      allow delete: if isSignedIn() && isOwner(resource.data.ownerId);
    }

    match /podcaster_export_jobs/{jobId} {
      allow read: if isEditor() || (
        isSignedIn() &&
        isOwner(resource.data.ownerId)
      );
    }

    match /analizarPDF/{sessionId} {
      allow read: if isEditor() || (
        isSignedIn() &&
        isOwner(resource.data.ownerId)
      );
      allow create: if isSignedIn() &&
        isOwner(request.resource.data.ownerId) &&
        isAnalizarPdfSessionShape(request.resource.data, sessionId);
      allow update: if isSignedIn() &&
        isOwner(resource.data.ownerId) &&
        request.resource.data.ownerId == resource.data.ownerId &&
        isAnalizarPdfSessionShape(request.resource.data, sessionId);
      allow delete: if isAdmin() || (
        isSignedIn() &&
        isOwner(resource.data.ownerId)
      );
    }

    match /analizarPDF/{sessionId}/revisions/{revisionId} {
      allow read: if isEditor() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/analizarPDF/$(sessionId)) &&
        isOwner(get(/databases/$(database)/documents/analizarPDF/$(sessionId)).data.ownerId)
      );
      allow write: if false;
    }

    match /analizarPDF/{sessionId}/analysisResults/{resultId} {
      allow read: if isEditor() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/analizarPDF/$(sessionId)) &&
        isOwner(get(/databases/$(database)/documents/analizarPDF/$(sessionId)).data.ownerId)
      );
      allow write: if false;
    }

    match /analizarPDF/{sessionId}/analysisResults/{resultId}/chunks/{chunkId} {
      allow read: if isEditor() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/analizarPDF/$(sessionId)) &&
        isOwner(get(/databases/$(database)/documents/analizarPDF/$(sessionId)).data.ownerId)
      );
      allow write: if false;
    }

    match /escapeRoom/{sessionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isOwner(request.resource.data.ownerId);
      allow update: if isAdmin() || (
        isSignedIn() &&
        isOwner(resource.data.ownerId) &&
        request.resource.data.ownerId == resource.data.ownerId
      );
      allow delete: if isAdmin() || (
        isSignedIn() &&
        isOwner(resource.data.ownerId)
      );

      match /topics/{topicId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() &&
          exists(/databases/$(database)/documents/escapeRoom/$(sessionId)) &&
          isOwner(get(/databases/$(database)/documents/escapeRoom/$(sessionId)).data.ownerId);
        allow update, delete: if isAdmin() || (
          isSignedIn() &&
          exists(/databases/$(database)/documents/escapeRoom/$(sessionId)) &&
          isOwner(get(/databases/$(database)/documents/escapeRoom/$(sessionId)).data.ownerId)
        );
      }
    }

    // Catálogo privado consumido exclusivamente por el backend con Admin SDK.
    match /pigpenSheetSources/{sourceId} {
      allow read, write: if false;
    }

    match /image_creator_sessions/{sessionId} {
      allow read: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() &&
        request.resource.data.ownerId == request.auth.uid &&
        isImageCreatorSessionShape(request.resource.data);
      allow update: if isSignedIn() &&
        resource.data.ownerId == request.auth.uid &&
        request.resource.data.ownerId == resource.data.ownerId &&
        isImageCreatorSessionShape(request.resource.data);
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /charlyBrownUnitSessions/{sessionId} {
      allow read: if isApprovedUser() &&
        resource.data.ownerUid == request.auth.uid;
      allow create: if isApprovedUser() &&
        request.resource.data.ownerUid == request.auth.uid;
      allow update: if isApprovedUser() &&
        resource.data.ownerUid == request.auth.uid &&
        request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if isApprovedUser() &&
        resource.data.ownerUid == request.auth.uid;
    }

    // Reglas para Marcie Blog Editor (sesiones y artículos)
    match /MarcieBlogEditor/{sessionId} {
      allow read: if isApprovedUser() && (
        resource.data.ownerId == request.auth.uid ||
        resource.data.ownerUid == request.auth.uid ||
        isEditor()
      );
      allow create: if isApprovedUser() && (
        request.resource.data.ownerId == request.auth.uid ||
        request.resource.data.ownerUid == request.auth.uid ||
        isEditor()
      );
      allow update: if isApprovedUser() && (
        resource.data.ownerId == request.auth.uid ||
        resource.data.ownerUid == request.auth.uid ||
        isEditor()
      );
      allow delete: if isAdmin() || (
        isApprovedUser() && (
          resource.data.ownerId == request.auth.uid ||
          resource.data.ownerUid == request.auth.uid
        )
      );

      match /{subcollection=**} {
        allow read, write: if isApprovedUser() && (
          isEditor() || isMarcieBlogEditorSessionOwner(sessionId)
        );
      }
    }

    match /MarcieBlogEidtor/{sessionId} {
      allow read, write: if false;
    }

    match /MarcieEditorialCalendar/{itemId} {
      allow read: if isApprovedUser();
      allow create, update, delete: if isEditor();
    }

    match /MarcieTrendSnapshots/{snapshotId} {
      allow read: if isApprovedUser();
      allow create, update, delete: if isEditor();
    }

    match /MarcieEditorialProfiles/{profileId} {
      allow read: if isApprovedUser();
      allow create, update, delete: if isEditor();
    }

    match /MarcieEditorialSettings/{settingsId} {
      allow read: if isApprovedUser();
      allow create, update, delete: if isEditor();
    }

    match /MarcieNotifications/{notificationId} {
      allow read: if isApprovedUser();
      allow update: if isEditor();
      allow create, delete: if false;
    }

    match /marcie_publications/{publicationId} {
      allow read: if isApprovedUser() && (isEditor() || resource.data.ownerId == request.auth.uid);
      allow write: if false;
    }

    match /MarciePublicationAudit/{auditId} {
      allow read: if isEditor();
      allow write: if false;
    }

    // Fuentes de lecturas para juego/editor.
    match /lecturasASC/{docId} {
      allow read: if isSignedIn() || isPublished(resource.data) || isEditor() || isDocOwner(resource.data) || isLecturaSharedWithUser(resource.data);
      allow write: if isEditor();
    }

    match /lecturasNuevas/{docId} {
      allow read: if isSignedIn() || isPublished(resource.data) || isEditor() || isDocOwner(resource.data) || isLecturaSharedWithUser(resource.data);
      allow create: if isEditor() || (isApprovedUser() && isDocOwner(request.resource.data));
      allow update, delete: if isEditor() || (isApprovedUser() && isDocOwner(resource.data));
    }

    // Lecturas game: lectura pública para ranking; escritura sólo owner autenticado o admin.
    match /lecturasGame/{playerId} {
      allow read: if true;
      allow create: if isAdmin() || (
        isSignedIn() &&
        request.auth.uid == playerId &&
        request.resource.data.uidOwner == request.auth.uid
      );
      allow update, delete: if isAdmin() || (
        isSignedIn() &&
        request.auth.uid == playerId &&
        (resource.data.uidOwner == request.auth.uid || !("uidOwner" in resource.data))
      );

      match /stats/{docId} {
        allow read: if true;
        allow write: if isAdmin() || (isSignedIn() && request.auth.uid == playerId);
      }

      match /history/{docId} {
        allow read: if true;
        allow write: if isAdmin() || (isSignedIn() && request.auth.uid == playerId);
      }

      match /mineblox_inventory/{docId} {
        allow read, write: if isGameDeveloper() || (isSignedIn() && request.auth.uid == playerId);
      }

      match /{document=**} {
        allow read, write: if isGameDeveloper();
      }
    }

    // Mineblox: sala visible para usuarios autenticados; control de escritura por maestro/roles.
    match /mineblox_rooms/{roomId} {
      allow read: if isSignedIn();
      allow create: if isGameDeveloper() || (
        isSignedIn() &&
        request.resource.data.teacherId == request.auth.uid
      );
      allow update, delete: if isGameDeveloper() || isMinebloxTeacher(roomId);

      match /players/{playerId} {
        allow read: if isSignedIn();
        allow create: if isGameDeveloper() || isMinebloxTeacher(roomId) || (
          isSignedIn() &&
          playerId == request.auth.uid
        );
        allow update, delete: if isGameDeveloper() || isMinebloxTeacher(roomId) || (
          isSignedIn() &&
          playerId == request.auth.uid
        );
      }

      match /chat/{docId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update, delete: if isGameDeveloper() || isMinebloxTeacher(roomId);
      }

      match /student_progress/{playerId}/answers/{docId} {
        allow read: if isGameDeveloper() || isMinebloxTeacher(roomId) || (
          isSignedIn() &&
          playerId == request.auth.uid
        );
        allow create: if isGameDeveloper() || isMinebloxTeacher(roomId) || (
          isSignedIn() &&
          playerId == request.auth.uid
        );
        allow update, delete: if isGameDeveloper() || isMinebloxTeacher(roomId);
      }

      match /items/{docId} {
        allow read: if isSignedIn();
        allow write: if isGameDeveloper() || isMinebloxTeacher(roomId);
      }

      match /events/{docId} {
        allow read: if isSignedIn();
        allow write: if isGameDeveloper() || isMinebloxTeacher(roomId);
      }

      match /quizzes/{docId} {
        allow read: if isSignedIn();
        allow write: if isGameDeveloper() || isMinebloxTeacher(roomId);
      }

      match /screenshots/{docId} {
        allow read: if isGameDeveloper() || isMinebloxTeacher(roomId);
        allow write: if isGameDeveloper() || isMinebloxTeacher(roomId);
      }

      match /{document=**} {
        allow read: if isGameDeveloper() || isMinebloxParticipant(roomId);
        allow write: if isGameDeveloper() || isMinebloxTeacher(roomId);
      }
    }

    // Unidades didácticas: autores/editores/admin ven el repositorio completo;
    // usuarios autenticados conservan acceso a sus propias unidades.
    match /Unidades/{unidadId} {
      allow read: if isEditor() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && (
        isEditor() ||
        request.resource.data.userId == request.auth.uid
      );
      allow update: if isEditor() || (
        isSignedIn() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == resource.data.userId
      );
      allow delete: if isEditor() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // audioTranslate: autores/editores/admin pueden revisar sesiones; el dueño conserva acceso propio.
    match /audioTranslate/{sessionId} {
      allow read: if isEditor() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isEditor() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // Users explícito.
    match /users/{uid} {
      // Chat y otros directorios internos necesitan listar perfiles autenticados.
      // La administración sigue protegida en frontend y escritura.
      allow read: if isSignedIn();

      allow create: if isOwner(uid) &&
        (
          !("role" in request.resource.data) || request.resource.data.role == "pending"
        ) &&
        (
          !("rol" in request.resource.data) || request.resource.data.rol == "pending"
        ) &&
        (
          !("userRole" in request.resource.data) || request.resource.data.userRole == "pending"
        ) &&
        (
          !("approvalStatus" in request.resource.data) || request.resource.data.approvalStatus == "pending"
        );

      allow update: if isAdmin() || (
        isOwner(uid) &&
        (
          !("role" in request.resource.data) || request.resource.data.role == resource.data.role
        ) &&
        (
          !("rol" in request.resource.data) || request.resource.data.rol == resource.data.rol
        ) &&
        (
          !("userRole" in request.resource.data) || request.resource.data.userRole == resource.data.userRole
        ) &&
        (
          !("approvalStatus" in request.resource.data) || request.resource.data.approvalStatus == resource.data.approvalStatus
        )
      );

      allow delete: if isAdmin() || isOwner(uid);

    }

    match /syaOverrides/{overrideId} {
      allow read: if (
        isSignedIn() &&
        (
          isEditor() ||
          resource.data.ownerUid == request.auth.uid ||
          (
            resource.data.publicContextKey is string &&
            resource.data.publicContextKey != ""
          )
        )
      );
      allow create: if isSignedIn() && (
        isEditor() ||
        request.resource.data.ownerUid == request.auth.uid
      );
      allow update: if isSignedIn() && (
        isEditor() ||
        (
          resource.data.ownerUid == request.auth.uid &&
          request.resource.data.ownerUid == resource.data.ownerUid
        )
      );
      allow delete: if isSignedIn() && (
        isEditor() ||
        resource.data.ownerUid == request.auth.uid
      );
    }

    // Chat/messages.
    match /messages/{conversationId} {
      allow read: if isSignedIn();
      allow write: if false;

      match /chat/{msgId} {
        allow read: if isChatParticipant(resource.data);
        allow create: if isSignedIn() && isChatMessageShape(request.resource.data);
        allow update, delete: if isAdmin() || isChatParticipant(resource.data);
      }
    }

    // Colecciones operativas (sin wildcard global).
    match /unidadesGeneradas/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn();
    }

    match /wordDownloads/{docId} {
      allow read: if isAdmin() || (isSignedIn() && isDocOwner(resource.data));
      allow create: if isSignedIn() && (
        isAdmin() ||
        isDocOwner(request.resource.data)
      );
      allow update, delete: if isAdmin() || (isSignedIn() && isDocOwner(resource.data));
    }

    match /analisisLecturas/{docId} {
      allow read: if isEditor() || (isSignedIn() && isDocOwner(resource.data));
      allow create: if isSignedIn() && isDocOwner(request.resource.data);
      allow update, delete: if isEditor() || (isSignedIn() && isDocOwner(resource.data));
    }

    match /secuenciaAlcance/{docId} {
      allow read: if isSignedIn();
      allow write: if isEditor();
    }

    match /metodologiaASC/{docId} {
      allow read: if isSignedIn();
      allow write: if isEditor();
    }

    match /moodleCourses/{docId} {
      allow read: if isSignedIn();
      allow create: if canAccessMoodleCourseData(request.resource.data, docId);
      allow update, delete: if canAccessMoodleCourseData(resource.data, docId) &&
        canAccessMoodleCourseData(request.resource.data, docId);
    }

    match /autoresEjemplo/{docId} {
      allow read: if isSignedIn();
      allow write: if isEditor();
    }

    match /conversacionIA/{docId} {
      allow read, write: if isSignedIn();
    }

    match /audioTranslateContextNotes/{sessionId} {
      allow read, write: if isAdmin() || isAudioSessionOwner(sessionId);
    }

    match /audioTranslateAnalyses/{docId} {
      allow read: if isAdmin() || (
        isSignedIn() &&
        resource.data.sessionId is string &&
        isAudioSessionOwner(resource.data.sessionId)
      );
      allow create: if isAdmin() || (
        isSignedIn() &&
        request.resource.data.sessionId is string &&
        isAudioSessionOwner(request.resource.data.sessionId)
      );
      allow update, delete: if isAdmin() || (
        isSignedIn() &&
        resource.data.sessionId is string &&
        isAudioSessionOwner(resource.data.sessionId)
      );
    }

    match /audioTranslateSegments/{sessionId} {
      allow read, write: if isAdmin() || isAudioSessionOwner(sessionId);
    }

    match /audioTranslateSummaries/{docId} {
      allow read: if isAdmin() || (
        isSignedIn() &&
        resource.data.sessionId is string &&
        isAudioSessionOwner(resource.data.sessionId)
      );
      allow create: if isAdmin() || (
        isSignedIn() &&
        request.resource.data.sessionId is string &&
        isAudioSessionOwner(request.resource.data.sessionId)
      );
      allow update, delete: if isAdmin() || (
        isSignedIn() &&
        resource.data.sessionId is string &&
        isAudioSessionOwner(resource.data.sessionId)
      );
    }

    match /comentarios/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isCommentShape(request.resource.data);
      allow update: if isAdmin() || (
        isSignedIn() &&
        resource.data.uid == request.auth.uid &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.lecturaId == resource.data.lecturaId &&
        request.resource.data.seccion == resource.data.seccion &&
        request.resource.data.autor == resource.data.autor &&
        request.resource.data.posicion == resource.data.posicion &&
        request.resource.data.longitud == resource.data.longitud &&
        isCommentShape(request.resource.data)
      ) || (
        isSignedIn() &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.lecturaId == resource.data.lecturaId &&
        request.resource.data.seccion == resource.data.seccion &&
        request.resource.data.comentario == resource.data.comentario &&
        request.resource.data.autor == resource.data.autor &&
        request.resource.data.posicion == resource.data.posicion &&
        request.resource.data.longitud == resource.data.longitud &&
        request.resource.data.seleccionadoPor is list
      );
      allow delete: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
    }

    match /imagenesCompartidas/{docId} {
      allow read: if resource.data.share == true || isEditor() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isSignedIn() && isImageShareShape(request.resource.data);
      allow update, delete: if isEditor() || (
        isSignedIn() &&
        resource.data.uid == request.auth.uid &&
        request.resource.data.uid == resource.data.uid &&
        isImageShareShape(request.resource.data)
      );
    }

    match /mindmaps/{docId} {
      allow read: if isAdmin() || (isSignedIn() && isDocOwner(resource.data));
      allow create: if isSignedIn() && isDocOwner(request.resource.data);
      allow update, delete: if isAdmin() || (isSignedIn() && isDocOwner(resource.data) && isDocOwner(request.resource.data));
    }

    match /compartidos/{docId} {
      allow read: if isAdmin() || (
        isSignedIn() && (
          resource.data.usuarioOrigenId == request.auth.uid ||
          resource.data.usuarioDestinoId == request.auth.uid
        )
      );
      allow create: if isSignedIn() &&
        request.resource.data.usuarioOrigenId == request.auth.uid &&
        isStringField(request.resource.data, "cursoId", 1, 200) &&
        isStringField(request.resource.data, "usuarioDestinoId", 1, 200) &&
        isStringField(request.resource.data, "tipo", 1, 40);
      allow update, delete: if isAdmin() || (
        isSignedIn() && resource.data.usuarioOrigenId == request.auth.uid
      );
    }

    match /camposFormativos/{docId} {
      allow read: if isSignedIn();
      allow write: if isEditor();
    }

    match /unidadSeriesCatalogo/{docId} {
      allow read, write: if isEditor();
    }

    match /lecturas_game_profiles_caps/{profileId} {
      allow read, write: if isAdmin() || (
        isSignedIn() &&
        profileId.matches("^" + request.auth.uid + "(:.*)?$")
      );
    }

    // Deny-by-default: todo lo no declarado queda bloqueado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
